// Cloudflare Workers hosting for the overseas copy of the site. Workers Builds
// runs `npm run build`, then `npx wrangler deploy` uploads dist/ as static
// assets. The Worker in the dashboard must be named the same as `name`.
{
  "name": "arc-raiders-wiki",
  "compatibility_date": "2026-09-24",
  "main": "worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Serve pages/items.html as is. The default strips .html with a redirect,
    // which breaks same-page #id links (core.js compares pathnames).
    "html_handling": "none"
  },
  // Map condition alerts by Web Push (worker.js). Off until set up: create the
  // namespace with `npx wrangler kv namespace create ALERTS`, put its id below,
  // add the VAPID_PRIVATE_KEY secret (scripts/vapid-keys.mjs), then uncomment.
  // "kv_namespaces": [{ "binding": "ALERTS", "id": "<namespace id>" }],
  // "triggers": { "crons": ["*/5 * * * *"] }
}
